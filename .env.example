# Copy this file to .env and fill in your Supabase project values
# (Supabase dashboard -> Project Settings -> API).
# The EXPO_PUBLIC_ prefix makes Expo inline these into the app bundle.
# The anon/publishable key is designed to be public; row-level security protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
